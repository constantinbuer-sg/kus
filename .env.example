# Werbeformular (api/contact.js) – Werte in Vercel unter Settings → Environment Variables eintragen.
# Für lokale Tests mit `vercel dev` diese Datei als .env.local kopieren (wird nicht committet).

# API-Key von https://resend.com (API Keys → Create API Key, Berechtigung „Sending access“)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Empfänger der Anfragen, mehrere mit Komma trennen
CONTACT_TO_EMAIL=name@soundsgood.de

# Absender – Domain muss in Resend verifiziert sein (Domains → Add Domain)
CONTACT_FROM_EMAIL=Kühnert & Schroeder <formular@kuehnertundschroeder.de>
